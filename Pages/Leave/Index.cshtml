@page
@model LeaveRequests.Pages.Leave.IndexModel

<h1>Leave Request Dashboard</h1>

<table class="table">
    <thead>
        <tr>
            <th>Dates</th>
            <th>Type</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model.Requests)
        {
            <tr>
                <td>@request.StartDate - @request.EndDate</td>
                <td>@request.Type</td>
                <td>@request.Status</td>
            </tr>
        }
    </tbody>
</table>