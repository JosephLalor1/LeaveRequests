@page
@model LeaveRequests.Pages.Leave.AuditModel

<h1>Audit Logs</h1>

<table class="table">
    <thead>
        <tr>
            <th>Time</th>
            <th>Actor Email</th>
            <th>Action</th>
            <th>Request ID</th>
            <th>Change</th>
            <th>Comment</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model.Entries)
        {
            <tr>
                <td>@entry.OccurredAt</td>
                <td>@entry.ActorEmail</td>
                <td>@entry.Action</td>
                <td>@entry.LeaveRequestId</td>
                <td>
                    @if (entry.OldStatus != null)
                    {
                        <text>@entry.OldStatus -> @entry.NewStatus</text>
                    }
                    else
                    {
                        @entry.NewStatus
                    }
                </td>
                <td>@entry.Comment</td>
            </tr>
        }
    </tbody>
</table>